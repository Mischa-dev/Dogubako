---
// Renders the optional local models from src/data/models.json (generated by
// scripts/gen-tools.mjs).
import models from '../data/models.json';

const GROUPS: Record<string, string> = {
  whisper: 'Speech recognition (whisper.cpp)',
  'whisper-vad': 'Voice activity detection',
  'face-detection': 'Face detection',
  piper: 'Text to speech voices (Piper)',
};
const size = (b: number) => (b >= 1 << 30 ? `${(b / (1 << 30)).toFixed(1)} GiB` : b >= 1 << 20 ? `${Math.round(b / (1 << 20))} MiB` : `${Math.round(b / 1024)} KiB`);
---

<table>
  <thead>
    <tr>
      <th>Model</th>
      <th>Group</th>
      <th>Size</th>
      <th>Languages</th>
      <th>License</th>
    </tr>
  </thead>
  <tbody>
    {
      models.map((m) => (
        <tr>
          <td>
            {m.name}
            <br />
            <code>{m.id}</code>
            {m.description && (
              <>
                <br />
                <small>{m.description}</small>
              </>
            )}
          </td>
          <td>
            <small>{GROUPS[m.group] ?? m.group}</small>
          </td>
          <td>{size(m.size_bytes)}</td>
          <td>{m.languages || '—'}</td>
          <td>
            <small>{m.license}</small>
          </td>
        </tr>
      ))
    }
  </tbody>
</table>
