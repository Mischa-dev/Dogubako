---
// The header's title, in two parts: the logo goes back to the website (dogubako.app),
// and "Docs" next to it goes to the start of the documentation.
import { logos } from 'virtual:starlight/user-images';
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const SITE = 'https://dogubako.app/';
---

<div class="brand sl-flex">
	<a href={SITE} class="site-title sl-flex" title="Back to dogubako.app">
		{
			logos.dark && logos.light && (
				<>
					<img class="light:sl-hidden print:hidden" alt="" src={logos.dark.src} width={logos.dark.width} height={logos.dark.height} />
					<img class="dark:sl-hidden print:block" alt="" src={logos.light.src} width={logos.light.width} height={logos.light.height} />
				</>
			)
		}
		<span translate="no">{siteTitle}</span>
		<span class="sr-only">website</span>
	</a>
	<a href={siteTitleHref} class="docs-home">Docs</a>
</div>

<style>
	@layer starlight.core {
		.brand {
			align-items: center;
			gap: 0.625rem;
			min-width: 0;
		}
		.site-title {
			align-items: center;
			gap: var(--sl-nav-gap);
			font-size: var(--sl-text-h4);
			font-weight: 600;
			color: var(--sl-color-text-accent);
			text-decoration: none;
			white-space: nowrap;
			min-width: 0;
		}
		img {
			height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
			width: auto;
			max-width: 100%;
			object-fit: contain;
			object-position: 0 50%;
		}
		.docs-home {
			flex: none;
			padding: 0.2rem 0.6rem;
			border-radius: 999px;
			border: 1px solid var(--sl-color-hairline);
			font-size: var(--sl-text-sm);
			font-weight: 500;
			line-height: 1.4;
			color: var(--sl-color-gray-2);
			text-decoration: none;
		}
		.docs-home:hover {
			color: var(--sl-color-white);
			border-color: var(--sl-color-gray-4);
		}
	}
</style>
