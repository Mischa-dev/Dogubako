---
// Renders the external engines from src/data/dependencies.json (generated by
// scripts/gen-tools.mjs) with install commands for each package manager.
import deps from '../data/dependencies.json';

const managers = [
  ['brew', 'macOS'],
  ['apt', 'Debian/Ubuntu'],
  ['dnf', 'Fedora'],
  ['pacman', 'Arch'],
  ['winget', 'Windows'],
] as const;
---

<table class="dgb-deps">
  <thead>
    <tr>
      <th>Engine</th>
      <th>Used for</th>
      <th>Install</th>
    </tr>
  </thead>
  <tbody>
    {
      deps.map((d) => {
        const pkgs = managers.filter(([k]) => (d.install as Record<string, string | null>)[k]);
        return (
          <tr>
            <td>
              <a href={d.install.url ?? undefined}>{d.name}</a>
              <br />
              <code>{d.id}</code>
              <br />
              <small class="dgb-muted">{d.license}</small>
            </td>
            <td>
              {d.purpose}
              <br />
              <small class="dgb-muted">{d.tools > 0 ? `${d.tools} ${d.tools === 1 ? 'tool requires' : 'tools require'} it` : 'Optional'}</small>
            </td>
            <td class="dgb-pkgs">
              {pkgs.length === 0 ? (
                <small>
                  See <a href={d.install.url ?? undefined}>the project site</a>
                </small>
              ) : (
                pkgs.map(([k, label]) => (
                  <span class="dgb-pkg">
                    <small>{label}</small> <code>{(d.install as Record<string, string>)[k]}</code>
                  </span>
                ))
              )}
            </td>
          </tr>
        );
      })
    }
  </tbody>
</table>
