{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dogubako",
  "version": "0.1.0",
  "identifier": "dev.dogubako.app",
  "build": {
    "frontendDist": "../../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../../../web run dev",
    "beforeBuildCommand": "npm --prefix ../../../web run build"
  },
  "app": {
    "windows": [
      {
        "title": "Dogubako",
        "width": 1200,
        "height": 800,
        "minWidth": 380,
        "minHeight": 520,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; frame-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": { "allow": ["$APPDATA/**", "$APPLOCALDATA/**", "$TEMP/**", "$HOME/**", "$DOWNLOAD/**", "$DESKTOP/**", "$DOCUMENT/**", "$PICTURE/**", "$VIDEO/**", "$AUDIO/**"], "deny": ["$HOME/.ssh/**", "$HOME/.gnupg/**", "$HOME/.aws/**", "$HOME/.config/**"] }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Local-first utility toolbox",
    "longDescription": "Dogubako consolidates hundreds of everyday utilities — images, video, audio, speech, PDF, files, text, developer, data, network, design and system tools — into one private, local-first app.",
    "license": "AGPL-3.0-or-later",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": { "deb": { "depends": [], "recommends": ["ffmpeg", "qpdf", "poppler-utils", "tesseract-ocr", "libimage-exiftool-perl", "ghostscript", "p7zip-full"] } }
  }
}
