# systemd unit for a native (non-Docker) server install.
#   sudo useradd --system --home /var/lib/dogubako dogubako
#   sudo install -m755 target/release/dogubako /usr/local/bin/
#   sudo cp deploy/dogubako.service /etc/systemd/system/ && sudo systemctl enable --now dogubako
[Unit]
Description=Dogubako utility toolbox server
After=network-online.target
Wants=network-online.target

[Service]
User=dogubako
Group=dogubako
Environment=DOGUBAKO_DATA_DIR=/var/lib/dogubako
Environment=DOGUBAKO_BIND=127.0.0.1:8420
EnvironmentFile=-/etc/dogubako.env
ExecStart=/usr/local/bin/dogubako server start
Restart=on-failure
StateDirectory=dogubako
# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/dogubako
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=8G
TasksMax=512

[Install]
WantedBy=multi-user.target
