# Copy to .env next to docker-compose.yml. Everything here is optional.

# Engines baked into the image (rebuild after changing: docker compose build)
DOGUBAKO_WITH_OFFICE=0      # 1 = LibreOffice for Office -> PDF conversion (~500 MB)
DOGUBAKO_WITH_WHISPER=1     # speech recognition engine (models are downloaded in the app)
DOGUBAKO_WITH_PIPER=1       # text-to-speech engine (voices are downloaded in the app)
DOGUBAKO_WITH_REMBG=0       # 1 = rembg background removal (~600 MB; models are downloaded in the app)

# Plain-words mode: one shared model offered to every user as "This server".
# Any OpenAI-compatible endpoint with tool calling works.
DOGUBAKO_ASSISTANT_ENABLED=true
DOGUBAKO_ASSISTANT_BASE_URL=          # e.g. https://api.openai.com/v1 or http://ollama:11434/v1
DOGUBAKO_ASSISTANT_MODEL=             # e.g. gpt-6-luna
DOGUBAKO_ASSISTANT_API_KEY=           # kept on the server, never sent to browsers
DOGUBAKO_ASSISTANT_ALLOW_PRIVATE=false  # true for a model on this machine/LAN (Ollama, LM Studio)
